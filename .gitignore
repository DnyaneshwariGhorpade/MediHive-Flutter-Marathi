app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables (contains actual credentials)
/assets/.env

# Google credentials and tokens (secrets - never commit)
credentials/
drive_token.json
drive_token.json.bak
oauth_credentials.json

# Backend database and local images
backend/medihive.db
storage/

# Persisted Google Sheet ID (auto-generated on first sync)
sheet_id.json
